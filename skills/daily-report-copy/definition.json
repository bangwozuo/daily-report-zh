        "type": "object"
      },
      "files": {
        "type": "array"
      },
      "data_origin": {
        "type": "string"
      }
    }
  },
  "purpose": "将已核对指标和已确认异常转为可编辑日报、指标明细与明日排查行动。",
  "conditions": [
    "接收原始四指标、报告期、同星期对比、特殊期、店龄及确认异常；不承担接入校验或重新检测。",
    "数值、健康区间与关键数选择需report_copy.py真实结果；缺对比不编造，归因不得从统计相关直接写成已证实原因。"
  ],
  "acceptance": [
    "结论不超过40字，正文不超过200字；营收必选，依退款率、转化率、客单价偏离优先序取三个数，每数附参照或明确缺口。",
    "最多一句提醒、一个不超过60字且含责任人/动作/范围的建议；特殊期、新店与小样本不写异常。",
    "交付五章节经营日报.docx、五页签日报数据摘要.xlsx与report_copy.json，保留全部指标和异常证据，人工复核前不发布。"
  ],
  "knowledge_ids": [
    "daily-report-zh:knowledge:metric_contract",
    "daily-report-zh:knowledge:report_template",
    "daily-report-zh:knowledge:store_context"
  ],

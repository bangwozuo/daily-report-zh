{
  "id": "skill-daily-report-copy",
  "name": "日报文案",
  "version": "0.2.0-rc.1",
  "kind": "generic",
  "input_schema": {
    "type": "object",
    "properties": {
      "operation": {
        "const": "copy"
      },

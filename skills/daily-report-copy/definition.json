    "properties": {
      "status": {
        "enum": [
          "draft",
          "needs_input",
          "blocked"
        ]
      },
      "staff_id": {
        "const": "daily-report-zh"
      },
      "operation": {
        "enum": [
          "sync",
          "detect",
          "copy",
          "collect",
          "daily",
          "alert",
          "weekly"
        ]
      },

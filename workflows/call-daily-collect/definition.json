{
  "id": "skill-call-daily-collect",
  "name": "经营数据归集",
  "version": "0.2.0-rc.1",
  "kind": "workflow_call",
  "input_schema": {
    "type": "object",
    "properties": {
      "operation": {
        "const": "collect"
      },
      "source_ref": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifact_id",
          "revision",
          "sha256"
        ],
        "additionalProperties": false
      },
      "metrics_ref": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifact_id",
          "revision",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "operation"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "status",
      "staff_id",
      "operation",
      "output",
      "files",
      "data_origin"
    ],
    "properties": {
      "status": {
        "enum": [
          "draft",
          "needs_input",
          "blocked"
        ]
      },
      "staff_id": {
        "const": "daily-report-zh"
      },
      "operation": {
        "enum": [
          "sync",
          "detect",
          "copy",
          "collect",
          "daily",
          "alert",
          "weekly"
        ]
      },
      "output": {
        "type": "object"
      },
      "files": {
        "type": "array"
      },
      "data_origin": {
        "type": "string"
      }
    }
  },
  "purpose": "编排导出接入体检、门禁、逐源归集和断供台账，向下游提供可追溯的资格材料。",
  "conditions": [
    "每日21:30外部收数；需要源配置、区间、每日到数、预处理样本和采集策略，实际搬运由客户完成。",
    "必须真实调用sync.py且取得剔除个人信息的执行证据；未授权数据不可因告警级状态而进入分析。",
    "本次不判定放行；缺执行和人工确认材料返回父任务。"
  ],
  "acceptance": [
    "空源停止；红线源阻断下游，不以剔除建议代替已完成清理；人工未确认维持待确认。",
    "归集单列已归集/待补齐/已剔除、门禁理由、源清单、断供明细及汇总；低于50%不可用，断供日原样保留。",
    "交付采集归集单.xlsx、collect.json及sync原始产物；downstream_allowed必须与阻断和人工确认状态一致。"
  ],
  "knowledge_ids": [
    "daily-report-zh:knowledge:source_register",
    "daily-report-zh:knowledge:metric_contract",
    "daily-report-zh:knowledge:privacy_release"
  ],
